{
  "name": "lavina-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "predev": "pnpm media:prepare",
    "dev": "astro dev",
    "prebuild": "pnpm media:prepare",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && eslint . && prettier --check .",
    "format": "prettier --write .",
    "validate-config": "node scripts/validate-config.mjs",
    "audit-compliance": "node scripts/audit-compliance.mjs",
    "audit-a11y": "node scripts/audit-a11y.mjs",
    "audit-lighthouse": "node scripts/audit-lighthouse.mjs",
    "audit-seo": "node scripts/audit-seo.mjs",
    "audit-contraste": "node scripts/audit-contraste.mjs",
    "media:prepare": "node scripts/prepare-media.mjs",
    "capturar": "node scripts/capturar.mjs",
    "media:manifesto": "node scripts/gerar-manifesto.mjs && node scripts/validar-manifesto.mjs",
    "media:validar": "node scripts/validar-manifesto.mjs",
    "media:pares": "node scripts/alinhar-pares.mjs",
    "media:stills": "node scripts/extract-stills.mjs",
    "media:catalogo": "node scripts/gerar-catalogo.mjs",
    "test:config": "node --test scripts/test-config.mjs",
    "build:producao": "LAVINA_MODO=producao pnpm validate-config && LAVINA_MODO=producao pnpm build && LAVINA_MODO=producao pnpm audit-compliance",
    "marca": "node scripts/marca.mjs",
    "medir-animacoes": "node scripts/medir-animacoes.mjs",
    "test:entrada": "node --test scripts/test-entrada.mjs",
    "capturar:entrada": "node scripts/capturar-entrada.mjs",
    "test:home": "node --test scripts/test-home.mjs",
    "capturar:secoes": "node scripts/capturar-secoes.mjs"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "1.1.1",
    "globals": "17.13.0",
    "lighthouse": "13.5.0",
    "node-html-parser": "9.0.4",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
