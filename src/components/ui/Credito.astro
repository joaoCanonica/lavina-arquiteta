---
// Crédito técnico (ficha de revista): pares função → nome.
interface Props {
  itens: { funcao: string; nome: string | null }[];
  class?: string;
}
const { itens, class: classe } = Astro.props;
---

<dl class:list={['credito', classe]}>
  {
    itens
      .filter((i) => i.nome)
      .map((i) => (
        <div class="credito__item">
          <dt>{i.funcao}</dt>
          <dd>{i.nome}</dd>
        </div>
      ))
  }
</dl>

<style>
  .credito {
    display: grid;
    gap: var(--e-2);
    margin: 0;
    font-size: var(--t-pequeno);
  }
  .credito__item {
    display: grid;
    grid-template-columns: minmax(7.5rem, 30%) 1fr;
    gap: var(--e-4);
    padding-block: var(--e-2);
    border-top: var(--linha) solid var(--cor-linha);
  }
  dt {
    font-size: var(--t-rotulo);
    font-weight: var(--peso-rotulo);
    letter-spacing: var(--espaco-rotulo);
    text-transform: uppercase;
    color: var(--cor-texto-2);
    line-height: 1.7;
  }
  dd {
    margin: 0;
  }
</style>
