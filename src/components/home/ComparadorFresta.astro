---
// Comparador com a fresta como divisa (a alça é a luz). Arrastar (ponteiro/toque),
// tocar para posicionar, setas do teclado (input range nativo, aria-valuetext "Projeto 50%").
// Imagens já alinhadas pelo media:prepare (docs/dados/pares.json).
import Imagem from '../ui/Imagem.astro';
import Rotulo from '../ui/Rotulo.astro';

interface Props {
  par: string;
  tipo: 'projeto-executado' | 'antes-depois';
  altA: string;
  altB: string;
  proporcao: '4:5' | '3:2';
  tamanhos?: string;
  posicao?: number;
  class?: string;
}
const {
  par,
  tipo,
  altA,
  altB,
  proporcao,
  tamanhos = '100vw',
  posicao = 50,
  class: classe,
} = Astro.props;
const projeto = tipo === 'projeto-executado';
const [natA, natB] = projeto ? (['render', 'executado'] as const) : (['antes', 'depois'] as const);
const [nomeA, nomeB] = projeto ? ['Projeto', 'Executado'] : ['Antes', 'Depois'];
const id = `cmp-${par}`;
---

<figure
  class:list={['cmp', classe]}
  data-cmp
  data-midia
  data-nome-a={nomeA}
  style={`--pos:${posicao}%;--prop:${proporcao.replace(':', '/')}`}
>
  <div class="cmp__palco" data-cmp-palco>
    <div class="cmp__b">
      <Imagem id={`par:${par}:b`} alt={altB} natureza={natB} sizes={tamanhos} />
    </div>
    <div class="cmp__a" aria-hidden="false">
      <Imagem id={`par:${par}:a`} alt={altA} natureza={natA} sizes={tamanhos} />
    </div>
    <span class="cmp__luz" aria-hidden="true"><span class="cmp__nucleo"></span></span>
    <label class="so-leitor" for={id}>Comparar {nomeA.toLowerCase()} e {nomeB.toLowerCase()}</label>
    <input
      id={id}
      class="cmp__range"
      type="range"
      min="0"
      max="100"
      step="1"
      value={posicao}
      aria-valuetext={`${nomeA} ${posicao}%`}
      data-cmp-range
    />
  </div>
  <figcaption class="cmp__rotulos">
    <span class="cmp__lado"
      >{projeto && <span class="cmp__nome">Projeto</span>} <Rotulo natureza={natA} /></span
    >
    <span class="cmp__lado cmp__lado--b"><Rotulo natureza={natB} /></span>
  </figcaption>
  <slot />
</figure>

<script>
  // Liga cada comparador: range ↔ --pos; arraste com ponteiro (inclui toque) sobre o palco.
  document.querySelectorAll<HTMLElement>('[data-cmp]').forEach((cmp) => {
    const palco = cmp.querySelector<HTMLElement>('[data-cmp-palco]');
    const range = cmp.querySelector<HTMLInputElement>('[data-cmp-range]');
    if (!palco || !range) return;
    const nomeA = cmp.dataset['nomeA'] ?? 'Projeto';
    const aplicar = (v: number) => {
      const p = Math.min(100, Math.max(0, Math.round(v)));
      cmp.style.setProperty('--pos', `${p}%`);
      range.value = String(p);
      range.setAttribute('aria-valuetext', `${nomeA} ${p}%`);
    };
    range.addEventListener('input', () => aplicar(Number(range.value)));
    let arrastando = false;
    const posicao = (e: PointerEvent) => {
      const r = palco.getBoundingClientRect();
      aplicar(((e.clientX - r.left) / r.width) * 100);
    };
    palco.addEventListener('pointerdown', (e) => {
      arrastando = true;
      palco.setPointerCapture(e.pointerId);
      posicao(e);
      cmp.classList.add('cmp--ativo');
    });
    palco.addEventListener('pointermove', (e) => {
      if (arrastando) posicao(e);
    });
    const soltar = () => {
      arrastando = false;
      cmp.classList.remove('cmp--ativo');
    };
    palco.addEventListener('pointerup', soltar);
    palco.addEventListener('pointercancel', soltar);
  });
</script>

<style>
  .cmp {
    position: relative;
  }
  .cmp__palco {
    position: relative;
    aspect-ratio: var(--prop);
    overflow: hidden;
    touch-action: pan-y; /* rolagem vertical continua; o gesto horizontal compara */
    cursor: ew-resize;
    user-select: none;
  }
  .cmp__palco :global(picture),
  .cmp__palco :global(img) {
    width: 100%;
    height: 100%;
  }
  .cmp__palco :global(img) {
    object-fit: cover;
    pointer-events: none;
  }
  .cmp__b,
  .cmp__a {
    position: absolute;
    inset: 0;
  }
  .cmp__a {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  /* A alça é a luz: a fresta na vertical, com um núcleo mais denso no meio. */
  .cmp__luz {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: var(--linha-fresta);
    margin-left: calc(var(--linha-fresta) / -2);
    background: linear-gradient(180deg, transparent, var(--luz) 12%, var(--luz) 88%, transparent);
    box-shadow: var(--sombra-fresta);
    pointer-events: none;
  }
  .cmp__nucleo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3px;
    height: 4.5rem;
    transform: translate(-50%, -50%);
    background: #fff1d9;
    box-shadow:
      0 0 10px 2px rgb(247 217 168 / 0.7),
      0 0 30px 6px rgb(247 217 168 / 0.3);
    transition: height var(--dur-media) var(--ease-saida);
  }
  .cmp--ativo .cmp__nucleo,
  .cmp__palco:hover .cmp__nucleo {
    height: 7rem;
  }

  /* O range cobre o palco (teclado e leitores de tela); o arraste é do ponteiro. */
  .cmp__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .cmp:has(.cmp__range:focus-visible) .cmp__palco {
    outline: 2px solid var(--cor-foco);
    outline-offset: 4px;
    box-shadow: 0 0 0 8px var(--luz-halo);
  }

  .cmp__rotulos {
    display: flex;
    justify-content: space-between;
    gap: var(--e-4);
    padding-top: var(--e-4);
  }
  .cmp__lado {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-2) var(--e-3);
  }
  .cmp__nome {
    font-size: var(--t-rotulo);
    font-weight: var(--peso-forte);
    letter-spacing: var(--espaco-rotulo);
    text-transform: uppercase;
  }
  .cmp__lado--b {
    text-align: right;
    justify-content: flex-end;
  }
</style>
