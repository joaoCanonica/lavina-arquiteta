---
// 4. Presença em cada etapa (grafite). Gesto: o vídeo do dia no escritório como peça
// central e as 5 etapas como capítulos que levam o vídeo ao tempo do rótulo.
// Sem JS ou com economia de dados: etapas em lista com quadros do vídeo.
// Textos: COPY_DECK §3. Tempos: src/config/processo.ts (rótulos medidos no vídeo).
import Imagem from '../ui/Imagem.astro';
import Rotulo from '../ui/Rotulo.astro';
import VideoJanela from './VideoJanela.astro';

const ETAPAS = [
  {
    n: '01',
    etapa: 'Reunião inicial, para entender cada necessidade.',
    frase: '“Antes de falar de plantas, medidas e orçamentos… a gente fala sobre você.”',
    fonte: 'DNVwPbWxkqZ',
    tempo: 8,
    hora: '8 AM',
    quadro: 'quadro-um-dia-no-escritorio-01',
  },
  {
    n: '02',
    etapa: 'Estudo do espaço, da rotina e do estilo de vida de quem vai viver ali.',
    frase: 'Seu lifestyle, o que te encanta, o que você não gosta, suas memórias e sonhos.',
    fonte: 'DNVwPbWxkqZ',
    tempo: 14,
    hora: '9 AM',
    quadro: 'quadro-um-dia-no-escritorio-02',
  },
  {
    n: '03',
    etapa: 'Criação do conceito, onde estética e propósito se encontram.',
    frase: '“É como assistir a um filme na mente e depois desenhá-lo cena por cena.”',
    fonte: 'DMyqTe1MnUS',
    tempo: 23,
    hora: '10 AM',
    quadro: 'quadro-um-dia-no-escritorio-03',
  },
  {
    n: '04',
    etapa: 'Desenvolvimento do projeto técnico, com soluções funcionais e criativas.',
    frase: '“Cada escolha tem um motivo. Cada detalhe tem uma função.”',
    fonte: 'DZn_e-qOnLN',
    tempo: 34,
    hora: '2 PM',
    quadro: 'quadro-um-dia-no-escritorio-04',
  },
  {
    n: '05',
    etapa: 'Acompanhamento próximo da execução, para que tudo saia como planejado.',
    frase: '“Não existe acaso em um projeto bem executado.”',
    fonte: 'DZn_e-qOnLN',
    tempo: 52,
    hora: 'Entrega',
    quadro: 'quadro-um-dia-no-escritorio-06',
  },
];
---

<section
  class="etapas"
  data-theme="dark"
  data-tone="escuro"
  aria-labelledby="etapas-titulo"
  data-etapas
>
  <header class="etapas__topo">
    <p class="t-rotulo t-secundario">Processo</p>
    <h2 id="etapas-titulo" class="etapas__titulo">Presença em cada etapa</h2>
    <p class="etapas__intro" data-fonte-post="DNqdWgzOxED">
      Arquitetura é feita de detalhes e processos bem definidos. No nosso escritório, cada projeto
      passa por cinco etapas.
    </p>
  </header>

  <div class="etapas__video">
    <VideoJanela id="video-um-dia-no-escritorio" titulo="Um dia no escritório Lavina">
      <span data-fonte-post="DOd4IshDqUc">
        A rotina é cheia de reuniões, obras e detalhes. Por trás de tudo isso, existe gente que
        gosta de ver projetos virando lares.
      </span>
    </VideoJanela>
  </div>

  <ol class="etapas__lista">
    {
      ETAPAS.map((e) => (
        <li class="etapa" data-etapa data-tempo={e.tempo} data-midia>
          <span class="etapa__n" aria-hidden="true">
            {e.n}
          </span>
          <div class="etapa__texto">
            <h3 class="etapa__nome">{e.etapa}</h3>
            <p class="etapa__frase" data-fonte-post={e.fonte}>
              {e.frase}
            </p>
          </div>
          <span class="etapa__hora">{e.hora}</span>
          <button type="button" class="etapa__ir" data-etapa-ir hidden>
            <span class="so-leitor">
              Etapa {e.n}: ver no vídeo, a partir de {e.hora}
            </span>
          </button>
          <figure class="etapa__quadro">
            <Imagem id={e.quadro} alt="" natureza="video" sizes="9rem" />
            <Rotulo natureza="video" />
          </figure>
        </li>
      ))
    }
  </ol>

  <p class="etapas__ia t-pequeno" data-fonte-post="DNqdWgzOxED">
    A inteligência artificial também entra, de forma sutil, na organização do processo.
  </p>
</section>

<script>
  // Capítulos: só com JS e sem economia de dados (o vídeo é pesado).
  const secao = document.querySelector<HTMLElement>('[data-etapas]');
  const conexao = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  if (secao && !conexao?.saveData) {
    const janela = secao.querySelector<HTMLElement>('[data-janela]');
    const etapas = [...secao.querySelectorAll<HTMLElement>('[data-etapa]')];
    secao.classList.add('com-video');
    const marcar = (ativa: HTMLElement | undefined) =>
      etapas.forEach((e) => {
        e.classList.toggle('etapa--ativa', e === ativa);
        e.querySelector('[data-etapa-ir]')?.setAttribute(
          'aria-current',
          e === ativa ? 'step' : 'false',
        );
      });
    etapas.forEach((etapa) => {
      const b = etapa.querySelector<HTMLButtonElement>('[data-etapa-ir]');
      if (!b) return;
      b.hidden = false;
      b.addEventListener('click', () => {
        marcar(etapa);
        janela?.dispatchEvent(
          new CustomEvent('video-janela:ir', { detail: { tempo: Number(etapa.dataset['tempo']) } }),
        );
      });
    });
    // Enquanto o vídeo toca, a etapa do trecho atual fica marcada.
    janela?.addEventListener('video-janela:pronto', (e) => {
      const v = (e as CustomEvent<HTMLVideoElement>).detail;
      if (v.dataset['ligado']) return;
      v.dataset['ligado'] = '1';
      v.addEventListener('timeupdate', () => {
        const atual = [...etapas]
          .reverse()
          .find((et) => v.currentTime + 0.5 >= Number(et.dataset['tempo']));
        if (atual && !atual.classList.contains('etapa--ativa')) marcar(atual);
      });
    });
  }
</script>

<style>
  .etapas {
    display: grid;
    gap: var(--e-7);
    padding: var(--e-9) var(--margem);
    background: var(--cor-fundo);
    color: var(--cor-texto);
  }
  .etapas__topo {
    display: grid;
    gap: var(--e-4);
  }
  .etapas__titulo {
    font-size: var(--t-titulo);
    font-weight: var(--peso-display);
    max-width: 12ch;
  }
  .etapas__intro {
    max-width: 28rem;
    color: var(--cor-texto-2);
  }
  .etapas__video {
    width: min(100%, 20rem);
  }

  .etapas__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: etapa;
  }
  .etapa {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    grid-template-areas:
      'n texto'
      'n hora'
      'n quadro';
    gap: var(--e-2) var(--e-4);
    padding-block: var(--e-5);
    border-top: var(--linha) solid var(--cor-linha);
  }
  .etapa__n {
    grid-area: n;
    font-size: var(--t-rotulo);
    letter-spacing: 0.12em;
    color: var(--cor-texto-2);
    padding-top: 0.45em;
  }
  .etapa__texto {
    grid-area: texto;
    display: grid;
    gap: var(--e-2);
  }
  .etapa__nome {
    font-size: var(--t-corpo-grande);
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: 0;
  }
  .etapa__frase {
    font-family: var(--fonte-citacao);
    font-style: italic;
    font-weight: 300;
    color: var(--cor-texto-2);
  }
  .etapa__hora {
    grid-area: hora;
    font-size: var(--t-rotulo);
    font-weight: var(--peso-rotulo);
    letter-spacing: var(--espaco-rotulo);
    text-transform: uppercase;
    color: var(--cor-acento);
  }
  .etapa__quadro {
    grid-area: quadro;
    display: grid;
    gap: var(--e-2);
    width: 9rem;
  }
  .etapa__quadro :global(img) {
    aspect-ratio: 9 / 16;
    object-fit: cover;
  }

  /* Com vídeo: os quadros somem e cada etapa vira um capítulo clicável. */
  .com-video .etapa__quadro {
    display: none;
  }
  .com-video .etapa {
    grid-template-areas:
      'n texto'
      'n hora';
    cursor: pointer;
  }
  .etapa__ir {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .etapa__ir:focus-visible {
    outline-offset: -2px;
  }
  /* A etapa ativa é marcada pela fresta. */
  .etapa::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: var(--linha-fresta);
    background: linear-gradient(
      90deg,
      var(--cor-fresta),
      var(--cor-fresta-nucleo) 70%,
      transparent
    );
    box-shadow: var(--sombra-fresta);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--dur-fresta) var(--ease-saida);
  }
  .etapa--ativa::before {
    transform: scaleX(1);
  }
  .etapa--ativa .etapa__n {
    color: var(--luz);
  }

  .etapas__ia {
    color: var(--cor-texto-2);
    max-width: 30rem;
  }

  @media (min-width: 64rem) {
    .etapas {
      grid-template-columns: minmax(0, 1fr) 22rem;
      grid-template-areas:
        'topo video'
        'lista video'
        'ia video';
      column-gap: var(--e-9);
      align-items: start;
    }
    .etapas__topo {
      grid-area: topo;
    }
    .etapas__lista {
      grid-area: lista;
    }
    .etapas__ia {
      grid-area: ia;
    }
    .etapas__video {
      grid-area: video;
      width: 100%;
      position: sticky;
      top: 6rem;
    }
    .etapa {
      grid-template-columns: 4rem minmax(0, 1fr) 7rem;
      grid-template-areas:
        'n texto hora'
        'n quadro quadro';
    }
    .com-video .etapa {
      grid-template-areas: 'n texto hora';
    }
    .etapa__hora {
      text-align: right;
      padding-top: 0.4em;
    }
  }
</style>
