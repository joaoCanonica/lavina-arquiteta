---
// 9. Instagram (osso). Gesto: "@lavina.co.arq" em display e uma faixa horizontal com
// scroll-snap de 6 imagens NOSSAS (do manifesto; sem embed), cada uma ligada ao post.
import manifesto from '../../../media.manifest.json';
import { config } from '../../config/index.ts';
import Imagem from '../ui/Imagem.astro';
import Rotulo from '../ui/Rotulo.astro';
import { naturezaExibida } from './midia.ts';

const ITENS = [
  { id: 'cozinha-jc-depois-05', alt: 'Cozinha J|C: mesa de pedra e pendentes' },
  {
    id: 'banheiro-tons-claros-executado-01',
    alt: 'Banheiro em tons claros: vista geral com banheira',
  },
  { id: 'clinica-cordis-render-01', alt: 'Clínica Cordis: bancada de pedra escura e marcenaria' },
  { id: 'suite-fl-render-02', alt: 'Suíte F|L: vista geral em tons escuros' },
  {
    id: 'consultorio-jonny-arruda-depois-05',
    alt: 'Consultório Jonny Arruda: sala de exame com cortina',
  },
  { id: 'projeto-tb-render-01', alt: 'Projeto T|B: painel paramétrico de madeira com TV' },
];
const registros = new Map(manifesto.registros.map((r) => [r.id, r]));
const itens = ITENS.map((i) => {
  const r = registros.get(i.id);
  if (!r?.post?.url) throw new Error(`mídia sem post de origem: ${i.id}`);
  return { ...i, url: r.post.url, natureza: naturezaExibida(r.natureza), projeto: r.projeto };
});
const perfil = config.contato.instagram.valor[0];
---

<section class="insta" data-theme="light" data-tone="claro" aria-labelledby="insta-titulo">
  <header class="insta__topo">
    <p class="t-rotulo t-secundario">Instagram</p>
    <h2 id="insta-titulo" class="insta__perfil">{perfil?.usuario}</h2>
    <a class="insta__seguir" href={perfil?.url} target="_blank" rel="noopener noreferrer">
      Seguir no Instagram<span class="so-leitor"> (abre em nova aba)</span>
    </a>
  </header>
  <ul class="insta__faixa" aria-label="Posts no Instagram">
    {
      itens.map((i) => (
        <li class="insta__item" data-midia>
          <a href={i.url} target="_blank" rel="noopener noreferrer" class="insta__link">
            <Imagem
              id={i.id}
              alt={i.alt}
              natureza={i.natureza}
              sizes="(min-width: 64rem) 22rem, 70vw"
            />
            <span class="so-leitor"> (post no Instagram, abre em nova aba)</span>
          </a>
          <Rotulo natureza={i.natureza} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .insta {
    display: grid;
    gap: var(--e-7);
    padding: var(--e-9) 0;
    background: var(--cor-fundo);
    color: var(--cor-texto);
    overflow: hidden;
  }
  .insta__topo {
    display: grid;
    gap: var(--e-4);
    padding-inline: var(--margem);
  }
  .insta__perfil {
    font-size: clamp(2.5rem, 1rem + 6.5vw, 8rem);
    font-weight: var(--peso-display);
    line-height: 1;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .insta__seguir {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--e-4);
    min-height: 44px;
    color: inherit;
    font-size: var(--t-rotulo);
    font-weight: var(--peso-rotulo);
    letter-spacing: var(--espaco-rotulo);
    text-transform: uppercase;
    text-decoration: none;
  }
  .insta__seguir::after {
    content: '';
    width: 3.5rem;
    height: var(--linha);
    background: currentColor;
  }
  .insta__faixa {
    list-style: none;
    margin: 0;
    padding: 0 var(--margem) var(--e-4);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(70vw, 22rem);
    gap: var(--e-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margem);
    scrollbar-width: thin;
  }
  .insta__item {
    display: grid;
    gap: var(--e-3);
    scroll-snap-align: start;
  }
  .insta__link {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .insta__link :global(picture),
  .insta__link :global(img) {
    width: 100%;
    height: 100%;
  }
  .insta__link :global(img) {
    object-fit: cover;
    transition: transform var(--dur-media) var(--ease-saida);
  }
  .insta__link:hover :global(img) {
    transform: scale(1.03);
  }
</style>
