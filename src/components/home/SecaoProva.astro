---
// 2. A prova (grafite): Projeto × Executado. Gesto: comparador a toda largura com a
// fresta como divisa; um segundo par menor, deslocado. Textos: COPY_DECK §4.1/4.2.
import Credito from '../ui/Credito.astro';
import ComparadorFresta from './ComparadorFresta.astro';
---

<section class="prova" data-theme="dark" data-tone="escuro" aria-labelledby="prova-titulo">
  <header class="prova__topo">
    <p class="t-rotulo t-secundario">A prova</p>
    <h2 id="prova-titulo" class="prova__titulo">Projeto × Executado</h2>
  </header>

  <div class="prova__grande">
    <ComparadorFresta
      par="cozinha-projeto-executado-fornos"
      tipo="projeto-executado"
      proporcao="3:2"
      tamanhos="(min-width: 64rem) 92vw, 100vw"
      altA="Imagem 3D do projeto da Cozinha J|C: janela, pia, cooktop, torre de fornos e refrigerador"
      altB="Cozinha J|C executada no mesmo ângulo: marcenaria clara, torre de fornos e refrigerador"
    />
    <div class="prova__legenda">
      <p><strong>Cozinha J|C</strong> · Balneário Camboriú</p>
      <Credito
        itens={[
          { funcao: 'Projeto', nome: 'Lavina — coletivo de arquitetura' },
          { funcao: 'Imagem 3D', nome: 'Renata Nürnberg' },
        ]}
      />
    </div>
  </div>

  <div class="prova__par">
    <blockquote class="prova__citacao" data-fonte-post="DZn_e-qOnLN">
      <p>“Não existe acaso em um projeto bem executado.”</p>
      <footer>— Amanda Lavina</footer>
    </blockquote>
    <div class="prova__menor">
      <ComparadorFresta
        par="consultorio-projeto-executado-mesa"
        tipo="projeto-executado"
        proporcao="4:5"
        tamanhos="(min-width: 64rem) 34vw, 100vw"
        altA="Imagem 3D do projeto do Consultório Jonny Arruda: armário curvo, pia, estantes iluminadas e mesa oval"
        altB="Consultório Jonny Arruda executado no mesmo ângulo"
      />
      <div class="prova__legenda">
        <p><strong>Consultório Jonny Arruda</strong> · Lages</p>
        <Credito
          itens={[
            { funcao: 'Projeto', nome: 'Lavina — coletivo de arquitetura' },
            { funcao: 'Imagem 3D', nome: 'Renata Nürnberg' },
          ]}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .prova {
    display: grid;
    gap: var(--e-8);
    padding: var(--e-9) var(--margem);
    background: var(--cor-fundo);
    color: var(--cor-texto);
  }
  .prova__topo {
    display: grid;
    gap: var(--e-4);
    max-width: 44rem;
  }
  .prova__titulo {
    font-size: var(--t-titulo);
    font-weight: var(--peso-display);
  }
  .prova__grande {
    display: grid;
    gap: var(--e-4);
  }
  .prova__legenda {
    display: grid;
    gap: var(--e-3);
    max-width: 28rem;
    font-size: var(--t-pequeno);
  }
  .prova__par {
    display: grid;
    gap: var(--e-7);
  }
  .prova__citacao p {
    font-family: var(--fonte-citacao);
    font-style: italic;
    font-weight: 300;
    font-size: var(--t-citacao);
    line-height: 1.2;
    max-width: 14ch;
  }
  .prova__citacao footer {
    margin-top: var(--e-4);
    font-size: var(--t-pequeno);
    color: var(--cor-texto-2);
  }
  .prova__menor {
    display: grid;
    gap: var(--e-4);
    width: min(100%, 28rem);
  }

  @media (min-width: 64rem) {
    .prova__grande {
      margin-inline: calc(-1 * var(--margem) / 2);
    }
    .prova__legenda {
      grid-template-columns: auto 1fr;
      align-items: start;
      column-gap: var(--e-7);
      max-width: none;
      padding-inline: calc(var(--margem) / 2);
    }
    .prova__menor .prova__legenda {
      grid-template-columns: 1fr;
      padding: 0;
    }
    /* Segundo par menor, deslocado à direita; a frase ocupa o vazio à esquerda. */
    .prova__par {
      grid-template-columns: minmax(0, 1fr) 30rem;
      align-items: center;
      column-gap: var(--e-9);
    }
    .prova__menor {
      width: 100%;
    }
  }
</style>
