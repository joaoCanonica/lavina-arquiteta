---
// Link de projeto: no hover/foco, uma linha de luz percorre a borda inferior
// (da esquerda para a direita), como um perfil de LED acendendo.
interface Props {
  href: string;
  class?: string;
}
const { href, class: classe } = Astro.props;
---

<a href={href} class:list={['link-projeto', classe]}><slot /></a>

<style>
  .link-projeto {
    position: relative;
    display: inline-block;
    padding-block: var(--e-2);
    color: inherit;
    text-decoration: none;
  }
  /* Base: linha fina neutra. */
  .link-projeto::before,
  .link-projeto::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--linha);
  }
  .link-projeto::before {
    background: var(--cor-linha);
  }
  /* Luz que corre. */
  .link-projeto::after {
    height: var(--linha-fresta);
    background: linear-gradient(
      90deg,
      var(--cor-fresta) 0%,
      var(--cor-fresta-nucleo) 85%,
      transparent 100%
    );
    box-shadow: var(--sombra-fresta);
    transform: scaleX(0);
    transform-origin: 0 50%;
    opacity: 0;
    transition:
      transform var(--dur-media) var(--ease-saida),
      opacity var(--dur-curta) linear;
  }
  .link-projeto:hover::after,
  .link-projeto:focus-visible::after {
    transform: scaleX(1);
    opacity: 1;
  }
  .link-projeto:focus-visible {
    outline-offset: 6px;
  }
</style>
